   "source": [
    "def area(length,breadth):\n",
    "    return length*breadth\n",
    "\n",
    "length = float(input(\"Enter Length of your rectangle\"))\n",
    "breadth = float(input(\"Enter Breadth of your rectangle\"))\n",
    "\n",
    "print(\"Aread of Rectangle is :\", area(length,breadth) )"
